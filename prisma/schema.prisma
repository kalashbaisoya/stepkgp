// STEP IIT KGP — Incubation Management Platform
// Prisma schema. Grows module-by-module per docs/14-roadmap.md.
// Milestone 0 establishes the foundation: tenant seam, Identity & Access (RBAC), audit, settings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  Tenant seam (single-tenant in v1; reserved for future SaaS)
// ============================================================
model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  users     User[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ============================================================
//  Identity & Access (RBAC)
// ============================================================
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  email          String        @unique
  passwordHash   String
  name           String?
  phone          String?
  emailVerified  DateTime?
  status         UserStatus    @default(PENDING)
  roles          UserRole[]
  sessions       Session[]
  applications   Application[]
  reviewAssignments ReviewAssignment[]
  mentorAssignments MentorAssignment[]
  notifications  Notification[]
  notificationPreference NotificationPreference?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // applicant, reviewer, mentor, staff, admin, super_admin
  name        String
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // "application:review", "cms:publish", ...
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFY
  OTP
  PASSWORD_RESET
  RECOMMENDATION
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String // email or userId
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier, type])
}

// ============================================================
//  Audit & Settings (cross-cutting)
// ============================================================
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String
  targetType     String
  targetId       String?
  before         Json?
  after          Json?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// ============================================================
//  Notifications (Milestone 10) — event-driven email + in-app
// ============================================================
/// Editable message templates. Body/title/subject support {{placeholders}}.
model NotificationTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  title        String // in-app title
  emailSubject String
  body         String // shared body (both channels)
  channels     String[] @default(["inapp", "email"])
  updatedAt    DateTime @updatedAt
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  templateKey String
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id           String  @id @default(cuid())
  userId       String  @unique
  emailEnabled Boolean @default(true)
  inappEnabled Boolean @default(true)
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
//  CMS (Milestone 2) — structured-block content, versioned
// ============================================================
enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A singleton or standalone page (home, about, director, contact, ...).
/// Draft blocks live in ContentBlock; publishing snapshots them into ContentVersion
/// and copies the snapshot into `publishedBlocks` for fast public reads.
model Page {
  id              String           @id @default(cuid())
  key             String           @unique // "home", "about", ...
  title           String
  status          ContentStatus    @default(DRAFT)
  blocks          ContentBlock[]
  publishedBlocks Json? // last published snapshot (array of blocks) for public rendering
  publishedAt     DateTime?
  seo             SeoMeta?
  versions        ContentVersion[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ContentBlock {
  id     String @id @default(cuid())
  pageId String
  type   String // hero | richtext | statStrip | gallery | facilities | showcaseTeaser | directorMessage | partners | faq | cta
  data   Json
  order  Int
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model ContentVersion {
  id          String    @id @default(cuid())
  pageId      String
  version     Int
  snapshot    Json // full block array at publish time
  publishedBy String?
  publishedAt DateTime  @default(now())
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
}

/// A repeatable content type (news, events, facilities, faq, partners, downloads).
model Collection {
  id    String           @id @default(cuid())
  key   String           @unique
  name  String
  items CollectionItem[]
}

model CollectionItem {
  id           String        @id @default(cuid())
  collectionId String
  slug         String
  status       ContentStatus @default(DRAFT)
  order        Int           @default(0)
  data         Json
  publishedAt  DateTime?
  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([collectionId, slug])
  @@index([collectionId, status, order])
}

model MediaAsset {
  id         String   @id @default(cuid())
  url        String // public URL or storage key resolved to URL
  fileName   String
  mimeType   String
  sizeBytes  Int      @default(0)
  alt        String?
  createdAt  DateTime @default(now())
}

model NavigationItem {
  id       String  @id @default(cuid())
  location String // "primary" | "footer"
  label    String
  href     String
  order    Int
  parentId String?

  @@index([location, order])
}

model SeoMeta {
  id          String  @id @default(cuid())
  pageId      String  @unique
  title       String?
  description String?
  ogImage     String?
  page        Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ============================================================
//  Form Engine (Milestone 3) — forms as data, versioned
// ============================================================
enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  EMAIL
  PHONE
  DATE
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  FILE
  CURRENCY
  URL
  RICHTEXT
}

/// A named form (e.g. "Student Application"). Holds immutable published versions;
/// the working draft lives directly on the template's sections/fields.
model FormTemplate {
  id        String                @id @default(cuid())
  key       String                @unique
  name      String
  sections  FormSection[] // current draft structure
  versions  FormTemplateVersion[]
  cycles    Cycle[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

model FormTemplateVersion {
  id          String       @id @default(cuid())
  templateId  String
  version     Int
  snapshot    Json // full sections+fields at publish time (source of truth for submissions)
  publishedBy String?
  publishedAt DateTime     @default(now())
  template    FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
}

model FormSection {
  id         String       @id @default(cuid())
  templateId String
  key        String
  title      String
  order      Int
  fields     FormField[]
  template   FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, order])
}

model FormField {
  id          String      @id @default(cuid())
  sectionId   String
  key         String
  label       String
  type        FieldType
  required    Boolean     @default(false)
  order       Int
  helpText    String?
  validation  Json? // { min, max, minLength, maxLength, pattern }
  conditional Json? // { field, equals } — show when another field matches
  options     Json? // inline [{ value, label }] for SELECT/MULTISELECT/RADIO
  optionSetId String? // optional shared option set (reserved for reuse)
  section     FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  optionSet   OptionSet?  @relation(fields: [optionSetId], references: [id])

  @@index([sectionId, order])
}

model OptionSet {
  id     String        @id @default(cuid())
  key    String        @unique
  name   String
  values OptionValue[]
  fields FormField[]
}

model OptionValue {
  id          String    @id @default(cuid())
  optionSetId String
  value       String
  label       String
  order       Int
  optionSet   OptionSet @relation(fields: [optionSetId], references: [id], onDelete: Cascade)
}

// ============================================================
//  Cycles, Categories & Documents (Milestone 4)
// ============================================================
enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

/// An annual cohort. Binds a form template and (via CycleCategory) the categories
/// it accepts. Applications reference a cycle + category (Milestone 5).
model Cycle {
  id             String          @id @default(cuid())
  organizationId String?
  year           Int
  name           String
  status         CycleStatus     @default(DRAFT)
  opensAt        DateTime?
  closesAt       DateTime?
  formTemplateId String?
  formTemplate   FormTemplate?   @relation(fields: [formTemplateId], references: [id])
  scorecardId    String?
  scorecard      Scorecard?      @relation(fields: [scorecardId], references: [id])
  categories     CycleCategory[]
  applications   Application[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, year])
  @@index([status])
}

model Category {
  id           String                @id @default(cuid())
  key          String                @unique // student | faculty | staff | external
  name         String
  order        Int                   @default(0)
  cycles       CycleCategory[]
  documentReqs DocumentRequirement[]
  applications Application[]
}

model CycleCategory {
  cycleId    String
  categoryId String
  cycle      Cycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([cycleId, categoryId])
}

model Sector {
  id   String @id @default(cuid())
  key  String @unique
  name String
}

// ============================================================
//  Applications (Milestone 5)
// ============================================================
/// A single application: a user + cycle + category, filled against a published
/// form template version. Field values are stored by key; each submit snapshots an
/// immutable version. `status` is a free string now; Milestone 7 maps it to the
/// configurable lifecycle states.
model Application {
  id              String                  @id @default(cuid())
  organizationId  String?
  userId          String
  cycleId         String
  categoryId      String
  templateKey     String?
  templateVersion Int?
  status          String                  @default("draft")
  progress        Int                     @default(0)
  submittedAt     DateTime?
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle           Cycle                   @relation(fields: [cycleId], references: [id])
  category        Category                @relation(fields: [categoryId], references: [id])
  values          ApplicationFieldValue[]
  documents       ApplicationDocument[]
  versions        ApplicationVersion[]
  businessPlan    BusinessPlan?
  stateHistory    ApplicationStateHistory[]
  assignments     ReviewAssignment[]
  reviewNotes     ReviewNote[]
  incubation      Incubation?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([cycleId, status])
}

model ApplicationFieldValue {
  id            String      @id @default(cuid())
  applicationId String
  fieldKey      String
  value         Json
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, fieldKey])
}

model ApplicationVersion {
  id            String      @id @default(cuid())
  applicationId String
  version       Int
  snapshot      Json
  pdfKey        String?
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, version])
}

model ApplicationDocument {
  id             String      @id @default(cuid())
  applicationId  String
  requirementKey String
  storageKey     String
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploadedAt     DateTime    @default(now())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, requirementKey])
}

// ============================================================
//  Lifecycle, Review & Scoring (Milestone 7)
// ============================================================
/// Configurable workflow states (seeded, admin-reconfigurable).
model LifecycleState {
  id              String                    @id @default(cuid())
  key             String                    @unique
  name            String
  order           Int
  isTerminal      Boolean                   @default(false)
  fromTransitions LifecycleTransition[]     @relation("fromState")
  toTransitions   LifecycleTransition[]     @relation("toState")
  history         ApplicationStateHistory[]
}

model LifecycleTransition {
  id                 String         @id @default(cuid())
  fromStateId        String
  toStateId          String
  requiredPermission String?
  fromState          LifecycleState @relation("fromState", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState            LifecycleState @relation("toState", fields: [toStateId], references: [id], onDelete: Cascade)

  @@unique([fromStateId, toStateId])
}

model ApplicationStateHistory {
  id            String         @id @default(cuid())
  applicationId String
  stateId       String
  actorId       String?
  note          String?
  createdAt     DateTime       @default(now())
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  state         LifecycleState @relation(fields: [stateId], references: [id])

  @@index([applicationId, createdAt])
}

model Scorecard {
  id       String               @id @default(cuid())
  key      String               @unique
  name     String
  criteria ScorecardCriterion[]
  cycles   Cycle[]
}

model ScorecardCriterion {
  id          String    @id @default(cuid())
  scorecardId String
  key         String
  name        String
  weight      Float     @default(1)
  maxScore    Int       @default(10)
  order       Int
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  scores      Score[]
}

model ReviewAssignment {
  id             String          @id @default(cuid())
  applicationId  String
  reviewerId     String
  status         String          @default("pending") // pending | completed
  recommendation String? // recommend | hold | reject
  rationale      String?
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer       User            @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  scores         Score[]
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  @@unique([applicationId, reviewerId])
  @@index([reviewerId, status])
}

model Score {
  id           String             @id @default(cuid())
  assignmentId String
  criterionId  String
  value        Float
  assignment   ReviewAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterion    ScorecardCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, criterionId])
}

model ReviewNote {
  id            String      @id @default(cuid())
  applicationId String
  authorId      String
  body          String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

/// Structured business plan (Milestone 6) — replaces the uploaded Word document.
/// Sections are filled as forms and rendered to a branded PDF on submit.
model BusinessPlan {
  id            String                @id @default(cuid())
  applicationId String                @unique
  pdfKey        String?
  sections      BusinessPlanSection[]
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  updatedAt     DateTime              @updatedAt
}

model BusinessPlanSection {
  id             String       @id @default(cuid())
  businessPlanId String
  key            String
  title          String
  content        String       @default("")
  order          Int
  businessPlan   BusinessPlan @relation(fields: [businessPlanId], references: [id], onDelete: Cascade)

  @@unique([businessPlanId, key])
}

// ============================================================
//  Incubation Management (Milestone 8)
// ============================================================
/// Post-selection incubation record. Auto-created when an application enters the
/// "incubated" state. The 11-month scheduler scans `startDate` to flag graduation.
model Incubation {
  id                  String            @id @default(cuid())
  applicationId       String            @unique
  organizationId      String?
  startDate           DateTime          @default(now())
  agreementDate       DateTime?
  status              String            @default("active") // active | graduated | archived
  officeSpace         String?
  elevenMonthFlagged  Boolean           @default(false)
  elevenMonthFlaggedAt DateTime?
  graduatedAt         DateTime?
  application         Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  milestones          Milestone[]
  funding             FundingRecord[]
  mentors             MentorAssignment[]
  reviews             ReviewSchedule[]
  showcase            ShowcaseEntry?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, startDate])
}

model Milestone {
  id           String     @id @default(cuid())
  incubationId String
  title        String
  dueDate      DateTime?
  status       String     @default("pending") // pending | done
  order        Int        @default(0)
  incubation   Incubation @relation(fields: [incubationId], references: [id], onDelete: Cascade)
}

model FundingRecord {
  id           String     @id @default(cuid())
  incubationId String
  source       String
  amount       Decimal    @db.Decimal(14, 2)
  date         DateTime   @default(now())
  notes        String?
  incubation   Incubation @relation(fields: [incubationId], references: [id], onDelete: Cascade)
}

model MentorAssignment {
  id           String     @id @default(cuid())
  incubationId String
  mentorId     String
  incubation   Incubation @relation(fields: [incubationId], references: [id], onDelete: Cascade)
  mentor       User       @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([incubationId, mentorId])
  @@index([mentorId])
}

model ReviewSchedule {
  id           String     @id @default(cuid())
  incubationId String
  scheduledFor DateTime
  type         String     @default("monthly")
  status       String     @default("scheduled") // scheduled | done
  incubation   Incubation @relation(fields: [incubationId], references: [id], onDelete: Cascade)
}

/// Public showcase entry for a (graduated) startup — rendered by the directory (M9).
model ShowcaseEntry {
  id           String      @id @default(cuid())
  incubationId String?     @unique
  slug         String      @unique
  name         String
  description  String      @default("")
  sector       String?
  website      String?
  founders     Json?
  funding      String?
  achievements Json?
  socials      Json?
  gallery      Json?
  videos       Json?
  logoUrl      String?
  batch        String? // cohort/year label, e.g. "2006"
  stage        String? // Seed / Growth / Acquired / Established
  tags         String[] @default([])
  location     String?
  published    Boolean     @default(false)
  featured     Boolean     @default(false) // show on the homepage featured section
  incubation   Incubation? @relation(fields: [incubationId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

/// Admin-configurable business-plan section definitions: which sections exist,
/// whether they're required, and word-count limits. Applicants' BusinessPlanSection
/// content is validated against these on submit (Milestone 6+ enhancement).
model BusinessPlanSectionDef {
  id       String  @id @default(cuid())
  key      String  @unique
  title    String
  prompt   String  @default("")
  required Boolean @default(false)
  minWords Int?
  maxWords Int?
  order    Int
}

/// Required documents per category (optionally scoped to a specific cycle).
model DocumentRequirement {
  id           String   @id @default(cuid())
  categoryId   String
  cycleId      String?
  key          String
  label        String
  required     Boolean  @default(true)
  allowedTypes String[] @default([])
  maxSizeMb    Int      @default(10)
  order        Int      @default(0)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}
