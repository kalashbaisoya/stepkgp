# ---- Database ----
# Local dev via docker compose (see docker-compose.yml)
DATABASE_URL="postgresql://stepkgp:stepkgp@localhost:5432/stepkgp?schema=public"

# ---- App ----
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ---- Auth (Milestone 1) ----
AUTH_SECRET="change-me-generate-a-long-random-string"
SESSION_COOKIE_NAME="stepkgp_session"

# ---- Email (Milestone 1/10) ----
EMAIL_FROM="STEP IIT KGP <noreply@stepiitkgp.org>"
# SMTP_URL or provider API key added when the email adapter is wired.

# ---- Scheduler (Milestone 8) ----
# Bearer token protecting /api/cron/* (11-month incubation scan). Set in production.
CRON_SECRET=""

# ---- Object storage (Milestone 2/5) ----
# S3-compatible (Cloudflare R2 / AWS S3 / MinIO)
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
